# Copy this file's VARIABLE NAMES and VALUES into Render → Environment.
# Replace YOUR_... placeholders. Do NOT commit a filled copy to GitHub.

PORT=3000

ALLOWED_ORIGINS=http://localhost:5500,https://emporiumlibrary.me,https://www.emporiumlibrary.me
ADMIN_EMAILS=naieemq111@gmail.com

DRIVE_PARENT_FOLDER_ID=1BUzTOd7yNDvVN15udNhnVJw-7ixALdkX

# Preferred Drive auth (uses your own Drive quota via OAuth refresh token)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional label for logs only (the Google account email tied to refresh token)
GOOGLE_DRIVE_UPLOADER_EMAIL=

# Paste the entire contents of your Google service account JSON file.
# Fallback mode only if OAuth vars above are not set.
# Prefer one single line (no line breaks). Example starts with {"type":"service_account"...
GOOGLE_SERVICE_ACCOUNT_JSON=

# Paste the entire contents of your Firebase Admin private key JSON file.
# Prefer one single line. Example starts with {"type":"service_account"...
FIREBASE_SERVICE_ACCOUNT_JSON=
