# =============================================================================
# Emporium Academic API — environment variables
# =============================================================================
# Use this file as a LOCAL template (copy to ".env" and fill in).
# On Render: open your Web Service → Environment → add EACH key below manually
# (Render does not read this file from the repo; you copy values into the UI).
#
# JSON values: Render accepts multi-line in some UIs; otherwise paste the
# ENTIRE JSON as ONE LINE (remove line breaks inside the file).
# =============================================================================

# --- Server ---
# Render sets PORT automatically; optional locally:
PORT=3000

# --- CORS (required) ---
# Comma-separated list of allowed website origins (no paths, no trailing slash).
# Add every domain where academic.html is opened (production + local + Netlify if used).
ALLOWED_ORIGINS=http://localhost:5500,https://emporiumlibrary.me,https://www.emporiumlibrary.me

# --- Google Drive upload target ---
# Folder ID only (from URL: .../folders/THIS_PART)
DRIVE_PARENT_FOLDER_ID=1BUzTOd7yNDvVN15udNhnVJw-7ixALdkX

# --- Google Cloud service account (Step 2) ---
# Full JSON key for the account that has "Drive API" enabled and Editor access
# to the folder above. Never commit the real value to Git.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Firebase Admin SDK (Step 4) ---
# Full JSON from Firebase → Project settings → Service accounts → Generate new private key.
# Used to verify user ID tokens and write Firestore (academic_notes, users).
FIREBASE_SERVICE_ACCOUNT_JSON=
