rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.auth.token.email.lower() in [
          'naieemq111@gmail.com'
        ];
    }

    function isValidDriveUrl(url) {
      return url is string
        && url.size() > 0
        && url.size() <= 1000
        && url.matches('^https://drive\\.google\\.com/.*$');
    }

    function isValidBookShape() {
      return request.resource.data.keys().hasOnly([
        'title', 'author', 'genre', 'cover', 'driveLink', 'trending', 'newRelease', 'price', 'createdAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 200
      && request.resource.data.author is string
      && request.resource.data.author.size() > 0
      && request.resource.data.author.size() <= 120
      && request.resource.data.genre is string
      && request.resource.data.genre.size() > 0
      && request.resource.data.genre.size() <= 80
      && request.resource.data.cover is string
      && request.resource.data.cover.matches('^https?://.*$')
      && request.resource.data.driveLink is string
      && request.resource.data.driveLink.size() <= 1000
      && (request.resource.data.driveLink.size() == 0 || request.resource.data.driveLink.matches('^https://drive\\.google\\.com/.*$'))
      && request.resource.data.trending is bool
      && request.resource.data.newRelease is bool
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && request.resource.data.price <= 100000;
    }

    function isValidResourceCreate() {
      return request.resource.data.keys().hasOnly([
        'title', 'subject', 'type', 'uploader', 'driveLink', 'description', 'downloads', 'createdAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 200
      && request.resource.data.subject is string
      && request.resource.data.subject.size() > 0
      && request.resource.data.subject.size() <= 120
      && request.resource.data.type is string
      && request.resource.data.type in ['notes', 'books', 'papers', 'assignments', 'research paper']
      && request.resource.data.uploader is string
      && request.resource.data.uploader.size() > 0
      && request.resource.data.uploader.size() <= 120
      && isValidDriveUrl(request.resource.data.driveLink)
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 500
      && request.resource.data.downloads == 0;
    }

    function isSafeDownloadIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads is int
        && request.resource.data.downloads == resource.data.downloads + 1;
    }

    function isValidContributorCreate() {
      return request.resource.data.keys().hasOnly(['name', 'points', 'uploads'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.points == 5
        && request.resource.data.uploads == 1;
    }

    function isValidContributorIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'uploads'])
        && request.resource.data.points == resource.data.points + 5
        && request.resource.data.uploads == resource.data.uploads + 1;
    }

    function isSafeFlagsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trending', 'newRelease', 'price'])
        && request.resource.data.trending is bool
        && request.resource.data.newRelease is bool
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000;
    }

    match /books/{bookId} {
      allow read: if true;
      // Restrict write operations to explicit admin email(s).
      allow create: if isAdmin() && isValidBookShape();
      allow update: if isAdmin() && (isValidBookShape() || isSafeFlagsUpdate());
      allow update: if isSignedIn() && isSafeRatingUpdate();
      allow delete: if isAdmin();
    }

    function isSafeLikesIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is int
        && request.resource.data.likes == (('likes' in resource.data) ? resource.data.likes : 0) + 1;
    }

    function isAcademicNoteDownloadIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads is int
        && request.resource.data.downloads == resource.data.downloads + 1;
    }

    match /resources/{resourceId} {
      allow read: if true;
      // Academic hub is public — students upload without a Firebase account.
      allow create: if isValidResourceCreate();
      allow update: if isSafeDownloadIncrement() || isSafeLikesIncrement();
      allow delete: if isAdmin();
    }

    match /contributors/{contributorId} {
      allow read: if true;
      // Contributor records are created/updated alongside resource uploads.
      allow create: if isValidContributorCreate();
      allow update: if isValidContributorIncrement() || isAdmin();
      allow delete: if isAdmin();
    }

    // Academic Hub v2: created/updated only by Render backend (Firebase Admin SDK).
    // Clients may increment download counts only.
    match /academic_notes/{noteId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isAcademicNoteDownloadIncrement();
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Payment config (UPI id, QR, bank details). Public read for checkout; admin-only write.
    match /payment_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Buyer orders. Clients go through the Render backend (Admin SDK) for all reads/writes.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Private drive links for paid books. Backend-only access via Admin SDK.
    match /paid_book_assets/{bookId} {
      allow read, write: if false;
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    function isValidReviewCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'bookId','userId','displayName','avatarInitials',
          'rating','reviewText','helpfulCount','createdAt','updatedAt'
        ])
        && d.bookId is string && d.bookId.size() > 0
        && d.userId == request.auth.uid
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 120
        && d.avatarInitials is string && d.avatarInitials.size() <= 2
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.reviewText is string && d.reviewText.size() <= 600
        && d.helpfulCount == 0;
    }

    function isValidReviewUpdate() {
      let d = request.resource.data;
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      // Owner can update rating, reviewText, updatedAt only
      return resource.data.userId == request.auth.uid
        && affected.hasOnly(['rating','reviewText','updatedAt'])
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.reviewText is string && d.reviewText.size() <= 600;
    }

    function isHelpfulIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount'])
        && request.resource.data.helpfulCount == resource.data.helpfulCount + 1;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReviewCreate();
      allow update: if isSignedIn() && (isValidReviewUpdate() || isHelpfulIncrement());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid || isAdmin();
    }

    function isSafeRatingUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['avgRating','reviewCount'])
        && request.resource.data.avgRating is number
        && request.resource.data.avgRating >= 0
        && request.resource.data.avgRating <= 5
        && request.resource.data.reviewCount is int
        && request.resource.data.reviewCount >= 0;
    }
  }
}
